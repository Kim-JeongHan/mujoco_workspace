{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "MotionLimits": {
      "additionalProperties": false,
      "description": "Optional velocity and acceleration limits in the controlled joints' units.\n\nScalars apply to every joint; lists follow the resolved joint order.\nAn omitted value inherits the corresponding robot or recipe limit.",
      "properties": {
        "velocity_limit": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "items": {
                "exclusiveMinimum": 0,
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Velocity Limit"
        },
        "acceleration_limit": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "items": {
                "exclusiveMinimum": 0,
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Acceleration Limit"
        }
      },
      "title": "MotionLimits",
      "type": "object"
    },
    "StageRecipe": {
      "additionalProperties": false,
      "description": "One named pose and its execution limits, applied once per cube.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "offset_xyz_m": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Offset Xyz M",
          "type": "array"
        },
        "gripper_target_m": {
          "title": "Gripper Target M",
          "type": "number"
        },
        "arm": {
          "$ref": "#/$defs/MotionLimits"
        },
        "gripper": {
          "$ref": "#/$defs/MotionLimits"
        },
        "require_grasp": {
          "default": false,
          "title": "Require Grasp",
          "type": "boolean"
        },
        "min_lift_height_m": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Lift Height M"
        }
      },
      "required": [
        "name",
        "offset_xyz_m",
        "gripper_target_m"
      ],
      "title": "StageRecipe",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Fixed eight-stage workflow and robot-specific numeric parameters.",
  "properties": {
    "euler_xyz_degrees": {
      "anyOf": [
        {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Euler Xyz Degrees"
    },
    "frame": {
      "const": "grasp",
      "title": "Frame",
      "type": "string"
    },
    "arm": {
      "$ref": "#/$defs/MotionLimits"
    },
    "gripper": {
      "$ref": "#/$defs/MotionLimits"
    },
    "arm_tolerance": {
      "exclusiveMinimum": 0,
      "title": "Arm Tolerance",
      "type": "number"
    },
    "gripper_tolerance": {
      "exclusiveMinimum": 0,
      "title": "Gripper Tolerance",
      "type": "number"
    },
    "stages": {
      "items": {
        "$ref": "#/$defs/StageRecipe"
      },
      "title": "Stages",
      "type": "array"
    }
  },
  "required": [
    "frame",
    "arm_tolerance",
    "gripper_tolerance",
    "stages"
  ],
  "title": "CubeStackRecipe",
  "type": "object"
}
